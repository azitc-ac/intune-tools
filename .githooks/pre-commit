#!/bin/sh
# Pre-commit für dieses Monorepo: ein Ordner pro Tool, eine VERSION pro Tool.
#
#   1. Für jedes Tool mit Änderungen im Commit werden dessen Strukturchecks
#      gefahren (Tests/Invoke-RepoChecks.ps1). Schlägt einer fehl, bricht der
#      Commit ab - das ist der Punkt: die Checks liefen bisher nur, wenn jemand
#      daran dachte.
#   2. Danach wird die letzte Zahl der VERSION dieses Tools gehoben, damit sich
#      Builds unterscheiden lassen. Eine VERSION, die bereits im Commit liegt -
#      ein bewusster Sprung auf 2.1.0 - bleibt unangetastet.
#
# Einmal je Clone aktivieren:  git config core.hooksPath .githooks
# In Cloud-Sessions erledigt das .claude/hooks/git-identity.sh automatisch.

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Tool-Ordner der Änderung: die oberste Ebene jedes Pfades mit Verzeichnisanteil
tools=$(printf '%s\n' "$staged" | awk -F/ 'NF > 1 { print $1 }' | sort -u)
[ -n "$tools" ] || exit 0

# PowerShell finden. Fehlt sie (z.B. Linux-Clone), werden die Checks NICHT
# still übersprungen, sondern laut gemeldet - sonst hält der Hook nicht, was er
# verspricht.
shell_ps=""
for candidate in pwsh powershell powershell.exe; do
    if command -v "$candidate" >/dev/null 2>&1; then shell_ps="$candidate"; break; fi
done

status=0

for tool in $tools; do
    checks="$tool/Tests/Invoke-RepoChecks.ps1"
    [ -f "$checks" ] || continue
    if [ -z "$shell_ps" ]; then
        echo "pre-commit: WARNUNG - keine PowerShell gefunden, Checks für $tool NICHT gelaufen" >&2
        continue
    fi
    echo "pre-commit: Checks für $tool"
    if ! "$shell_ps" -NoProfile -File "$checks"; then
        echo "pre-commit: Checks für $tool fehlgeschlagen - Commit abgebrochen" >&2
        status=1
    fi
done

[ "$status" -eq 0 ] || exit 1

for tool in $tools; do
    version_file="$tool/VERSION"
    [ -f "$version_file" ] || continue
    # Schon im Commit? Dann ist es ein bewusster Sprung und bleibt, wie es ist.
    git diff --cached --quiet -- "$version_file" || continue
    v=$(tr -d '\r\n' < "$version_file")
    base=${v%.*}
    patch=${v##*.}
    case "$patch" in
        ''|*[!0-9]*)
            echo "pre-commit: $version_file enthält '$v' und endet nicht auf einer Zahl" >&2
            exit 1
            ;;
    esac
    printf '%s.%s\n' "$base" "$((patch + 1))" > "$version_file"
    git add "$version_file"
    echo "pre-commit: $version_file -> $base.$((patch + 1))"
done

exit 0
